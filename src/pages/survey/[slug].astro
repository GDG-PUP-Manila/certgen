---
import Layout from '../../layouts/Layout.astro';
import SurveyForm from '../../components/SurveyForm';
import { getSurveyBySlug } from '../../repositories/survey.repository';
import eventsData from '../../../data/event.json';

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}

// 1. Find the survey by slug
const survey = await getSurveyBySlug(slug as string);

if (!survey) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}

// 2. Find the associated event
let event = eventsData.find((e: any) => e.id === survey.event_id);

// Handle 404
if (!event) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}

// 3. Check if the survey is closed based on time or active flag
const now = new Date();
const closeTime = survey.close_time ? new Date(survey.close_time) : null;
const isClosed = !survey.is_active || (closeTime && now > closeTime);
---

<Layout 
  title={`${event.title} Survey | GDG PUP Manila`}
  description={event.description}
>
	<div class="max-w-3xl mx-auto py-10 px-4 md:py-16 animate-[fade-in_650ms_cubic-bezier(0.2,0.8,0.2,1)_both]">
		<div class="text-center mb-10 space-y-4">
			<div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-[0_8px_20px_rgba(17,24,39,0.06)] mb-2 border border-gray-100">
				<img src="/logo.png" alt="GDG Logo" class="h-10 w-10" />
			</div>
			
			<h1 class="text-3xl md:text-4xl font-black tracking-tight text-[#202124] px-4 leading-[1.15]">
				{event.title}
			</h1>
			<p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed px-4">
                                {isClosed 
                                  ? "This survey has already concluded. Thank you for your interest."
                                  : "Share your thoughts, verify your attendance, and instantly download your framed certificate."
                                }
                        </p>
                </div>

                <div class="relative">
                        {isClosed ? (
                          <div class="bg-gray-50 border border-gray-200 rounded-3xl p-10 text-center shadow-sm">
                            <h2 class="text-2xl font-bold text-gray-900 mb-3">Survey is Closed</h2>
                            <p class="text-gray-600 font-medium">
                              We are no longer accepting responses for this event survey. If you believe this is a mistake, please reach out to the organizers.
                            </p>
                            <a href="/" class="inline-flex items-center justify-center px-6 py-3 mt-6 text-sm font-semibold text-white transition-all bg-[#4285f4] hover:bg-[#3367d6] rounded-xl">
                              Back to Events
                            </a>
                          </div>
                        ) : (
                          <SurveyForm eventId={event.id} surveyData={survey} client:load />
                        )}
