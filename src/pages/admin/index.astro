---
import Layout from '../../layouts/Layout.astro';
import { isAuthenticated } from '../../lib/auth';
import { getAllEvents } from '../../repositories/event.repository';
import { getAllSurveys } from '../../repositories/survey.repository';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const events = await getAllEvents();
const surveys = await getAllSurveys();
---

<Layout title="Admin Dashboard | CertGen">
  <div class="max-w-7xl mx-auto py-10 px-4 md:py-16 animate-[fade-in_650ms_cubic-bezier(0.2,0.8,0.2,1)_both] w-full flex-grow flex flex-col">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-100 pb-8 mb-10">
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Admin Dashboard</h1>
        <p class="text-gray-500 text-sm mt-1">Manage events, certificates, and view survey responses</p>
      </div>
      <div class="flex items-center gap-3 w-full md:w-auto">
        <a 
          href="/admin/events/new" 
          class="flex-grow md:flex-grow-0 text-center font-bold px-5 py-3 rounded-2xl bg-[#4285f4] text-white hover:bg-[#3367d6] transition-colors shadow-[0_8px_20px_rgba(66,133,244,0.15)] text-sm"
        >
          Create New Event
        </a>
        <button 
          id="logout-btn"
          class="font-bold px-5 py-3 rounded-2xl border border-gray-200 text-gray-700 bg-white hover:bg-gray-50 transition-colors text-sm"
        >
          Sign Out
        </button>
      </div>
    </div>

    <!-- Main Content -->
    {events.length === 0 ? (
      <div class="text-center py-20 bg-white border border-gray-100 rounded-3xl p-8 shadow-[0_12px_30px_rgba(17,24,39,0.02)]">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-50 text-gray-400 mb-4 border border-gray-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900">No events found</h3>
        <p class="text-gray-500 text-sm mt-1 max-w-sm mx-auto">Get started by creating your first event and configuring its post-event survey.</p>
        <a href="/admin/events/new" class="mt-6 inline-flex font-bold px-5 py-3 rounded-2xl bg-[#4285f4] text-white hover:bg-[#3367d6] transition-colors text-sm shadow-[0_8px_20px_rgba(66,133,244,0.15)]">
          Create Event
        </a>
      </div>
    ) : (
      <div class="bg-white rounded-3xl border border-gray-100 shadow-[0_12px_30px_rgba(17,24,39,0.02)] overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-100">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Event Details</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Survey Slug</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Survey Status</th>
                <th class="px-6 py-4 class-right text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {events.map((event) => {
                const survey = surveys.find((s) => s.event_id === event.id);
                const dateObj = event.start_date ? new Date(event.start_date) : null;
                const formattedDate = dateObj ? dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'No date set';

                return (
                  <tr class="hover:bg-gray-50/50 transition-colors">
                    <td class="px-6 py-4">
                      <div class="text-base font-bold text-slate-900">{event.title}</div>
                      <div class="text-xs text-gray-500 mt-1 flex items-center gap-1.5">
                        <span>{formattedDate}</span>
                        {event.venue && (
                          <>
                            <span class="text-gray-300">•</span>
                            <span>{event.venue}</span>
                          </>
                        )}
                      </div>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600 font-mono">
                      {survey ? `/survey/${survey.slug}` : 'No survey set'}
                    </td>
                    <td class="px-6 py-4">
                      {survey ? (
                        <span class={`inline-flex px-2.5 py-1 text-xs font-bold rounded-full uppercase tracking-wide ${
                          survey.is_active 
                            ? 'bg-green-50 text-green-700 border border-green-200/50' 
                            : 'bg-red-50 text-red-700 border border-red-200/50'
                        }`}>
                          {survey.is_active ? 'Active' : 'Closed'}
                        </span>
                      ) : (
                        <span class="inline-flex px-2.5 py-1 text-xs font-bold rounded-full bg-yellow-50 text-yellow-700 border border-yellow-200/50 uppercase tracking-wide">
                          Pending Config
                        </span>
                      )}
                    </td>
                    <td class="px-6 py-4 text-right text-sm font-medium space-x-2">
                      <a 
                        href={`/admin/events/${event.id}/survey`} 
                        class="inline-flex items-center text-xs font-bold px-3.5 py-2 rounded-xl border border-gray-200 text-gray-700 bg-white hover:bg-gray-50 hover:border-gray-300 transition-colors shadow-sm"
                      >
                        Settings
                      </a>
                      <a 
                        href={`/admin/events/${event.id}/responses`} 
                        class="inline-flex items-center text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-900 text-white hover:bg-slate-800 transition-colors shadow-sm"
                      >
                        Responses
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>

  <script>
    const logoutBtn = document.getElementById('logout-btn');
    logoutBtn?.addEventListener('click', async () => {
      try {
        const response = await fetch('/api/admin/logout', { method: 'POST' });
        if (response.ok) {
          window.location.href = '/admin/login';
        }
      } catch (err) {
        console.error('Logout error:', err);
      }
    });
  </script>
</Layout>
